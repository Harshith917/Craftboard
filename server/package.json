{
  "name": "canvasflow-server",
  "version": "1.0.0",
  "description": "CanvaColab API - Express + Socket.IO (migrated from NestJS)",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && node migrate.js && tsc",
    "start": "node dist/src/index.js",
    "start:prod": "node dist/index.js",
    "migrate": "node migrate.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.1",
    "@liveblocks/node": "^3.18.5",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
