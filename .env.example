# Copy this file to .env and fill in real values.
# Used by `docker compose up` for the self-hosted stack.

# Database (defaults are fine for a local stack)
POSTGRES_USER=craftboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=craftboard

# Clerk (https://dashboard.clerk.com) — required
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Liveblocks (https://liveblocks.io/dashboard/apikeys) — required
LIVEBLOCKS_SECRET_KEY=sk_live_...
LIVEBLOCKS_WEBHOOK_SECRET=whsec_...

# Public URLs
FRONTEND_URL=http://localhost:8080
FRONTEND_URLS=http://localhost:8080
VITE_API_URL=http://localhost:4001

# AI assistant — optional (Ollama on the Docker host)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# Ports
API_PORT=4001
CLIENT_PORT=8080
